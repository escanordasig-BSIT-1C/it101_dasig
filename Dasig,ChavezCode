<html lang=>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DineFlow POS App</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Inter & Outfit -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        dineDark: '#231B1B',
                        dineCardDark: '#2C2322',
                        dinePillDark: '#382C2A',
                        dinePillHover: '#4A3B38',
                        dineAmber: '#E29D52',
                        dineAmberHover: '#D18C41',
                        dineLightCard: '#FFFFFF',
                        dineTextMuted: '#A09390'
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Outfit', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        .phone-shadow {
            box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.7), 0 0 30px rgba(162, 147, 194, 0.25);
        }
        @keyframes subtlePulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.6; }
        }
        .animate-subtle {
            animation: subtlePulse 2s infinite ease-in-out;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col items-center justify-center p-2 sm:p-6 font-sans select-none antialiased">

    <!-- TOP APPLICATION CONTROL BAR -->
    <header class="w-full max-w-md mb-3 flex items-center justify-between px-2 text-xs text-slate-400">
        <div class="flex items-center space-x-2">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
            <span class="font-medium text-slate-300">DineFlow POS v2.4</span>
        </div>
        <div class="flex items-center space-x-3">
            <button onclick="toggleShiftModal()" class="hover:text-amber-400 transition flex items-center gap-1 bg-slate-900 px-2.5 py-1 rounded-full border border-slate-800">
                <i class="fa-solid fa-clock"></i>
                <span>Shift: <strong class="text-emerald-400" id="shift-status-text">Active</strong></span>
            </button>
        </div>
    </header>

    <!-- MAIN IPHONE SHELL CONTAINER -->
    <div id="phone-frame" class="w-full max-w-[390px] h-[812px] bg-dineDark rounded-[48px] border-[10px] border-[#A293C2] phone-shadow flex flex-col relative overflow-hidden transition-all duration-300">
        
        <!-- IPHONE DYNAMIC ISLAND & TOP STATUS BAR -->
        <div class="w-full pt-3 px-7 flex items-center justify-between text-white text-xs font-semibold z-30 select-none">
            <span id="current-time">9:41</span>
            
            <div class="w-24 h-6 bg-black rounded-full flex items-center justify-between px-2 cursor-pointer hover:scale-105 transition" onclick="showToast('Dynamic Island: DineFlow System Online')">
                <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
                <div class="w-2 h-2 rounded-full bg-indigo-500/80"></div>
            </div>

            <div class="flex items-center gap-1.5 text-[11px]">
                <i class="fa-solid fa-signal"></i>
                <i class="fa-solid fa-wifi"></i>
                <i class="fa-solid fa-battery-full text-emerald-400"></i>
            </div>
        </div>

        <!-- NOTIFICATION TOAST POPUP -->
        <div id="toast" class="absolute top-12 left-4 right-4 z-50 transform -translate-y-20 opacity-0 transition-all duration-300 bg-slate-900/95 backdrop-blur-md text-white text-xs py-2.5 px-4 rounded-xl border border-amber-500/40 shadow-2xl flex items-center justify-between pointer-events-none">
            <div class="flex items-center space-x-2">
                <i class="fa-solid fa-circle-check text-amber-400 text-sm" id="toast-icon"></i>
                <span id="toast-msg" class="font-medium">Item added to draft order!</span>
            </div>
            <span class="text-[10px] text-slate-400">Just now</span>
        </div>

        <!-- APP CONTENT SCROLLABLE AREA -->
        <main class="flex-1 overflow-y-auto no-scrollbar relative flex flex-col px-4 pt-2 pb-20">

            <!-- ================= PAGE 1: HOME VIEW ================= -->
            <div id="view-home" class="space-y-4">
                <div class="pt-1">
                    <h1 class="text-2xl font-bold tracking-tight text-white font-display">Home</h1>
                    <p class="text-xs text-dineTextMuted mt-0.5">Start your service from your restaurant workspace.</p>
                </div>

                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                    <input type="text" placeholder="Search menu or ingredients" onkeyup="handleHomeSearch(this.value)"
                        class="w-full bg-white text-gray-800 text-xs rounded-full pl-9 pr-4 py-2.5 outline-none placeholder-gray-400 shadow-sm border border-gray-100 font-medium focus:ring-2 focus:ring-dineAmber transition">
                </div>

                <div class="relative rounded-2xl overflow-hidden bg-gradient-to-r from-amber-950 via-stone-900 to-black p-4 border border-amber-500/20 shadow-md">
                    <div class="relative z-10 w-2/3 pr-2">
                        <div class="inline-block bg-yellow-400 text-black text-[10px] font-extrabold px-1.5 py-0.5 rounded uppercase tracking-wider mb-1">
                            Special Promo
                        </div>
                        <h2 class="text-lg font-black text-yellow-400 tracking-tight leading-tight font-display uppercase italic drop-shadow">
                            20% OFF SEAFOODS!
                        </h2>
                        <p class="text-[10px] text-gray-300 mt-1 leading-snug">
                            Fresh catches, bold flavors, at a better price!
                        </p>
                        <button onclick="switchTab('menu'); filterCategory('Seafood')" class="mt-2.5 bg-dineAmber hover:bg-dineAmberHover text-stone-950 text-xs font-bold px-3 py-1.5 rounded-full flex items-center gap-1.5 shadow transition">
                            <span>Order Now</span>
                            <i class="fa-solid fa-arrow-right text-[10px]"></i>
                        </button>
                    </div>
                    <img src="https://images.unsplash.com/photo-1534422298391-e4f8c172dddb?auto=format&fit=crop&w=400&q=80" alt="Seafood Dish" 
                        class="absolute right-0 top-0 bottom-0 w-1/2 object-cover opacity-80 rounded-r-2xl mask-gradient">
                    <div class="absolute inset-0 bg-gradient-to-r from-stone-950 via-stone-950/70 to-transparent"></div>
                </div>

                <div class="space-y-2">
                    <button onclick="switchTab('menu')" class="w-full bg-dinePillDark hover:bg-dinePillHover text-stone-200 py-2.5 px-4 rounded-2xl flex items-center justify-between text-xs font-medium transition shadow-sm border border-white/5 active:scale-[0.99]">
                        <div class="flex items-center gap-2.5">
                            <span class="text-dineAmber text-[10px]">♦</span>
                            <span>Menu</span>
                        </div>
                        <i class="fa-solid fa-chevron-right text-[10px] text-stone-500"></i>
                    </button>

                    <button onclick="switchTab('tables')" class="w-full bg-dinePillDark hover:bg-dinePillHover text-stone-200 py-2.5 px-4 rounded-2xl flex items-center justify-between text-xs font-medium transition shadow-sm border border-white/5 active:scale-[0.99]">
                        <div class="flex items-center gap-2.5">
                            <span class="text-dineAmber text-[10px]">♦</span>
                            <span>Table status</span>
                        </div>
                        <i class="fa-solid fa-chevron-right text-[10px] text-stone-500"></i>
                    </button>

                    <button onclick="switchTab('orders')" class="w-full bg-dinePillDark hover:bg-dinePillHover text-stone-200 py-2.5 px-4 rounded-2xl flex items-center justify-between text-xs font-medium transition shadow-sm border border-white/5 active:scale-[0.99]">
                        <div class="flex items-center gap-2.5">
                            <span class="text-dineAmber text-[10px]">♦</span>
                            <span>Orders</span>
                        </div>
                        <i class="fa-solid fa-chevron-right text-[10px] text-stone-500"></i>
                    </button>
                </div>

                <div class="pt-1">
                    <h3 class="text-sm font-semibold text-white mb-2.5 flex items-center justify-between">
                        <span>Recommended for You!</span>
                        <span class="text-[11px] text-dineAmber font-normal cursor-pointer hover:underline" onclick="switchTab('menu')">See all</span>
                    </h3>

                    <div id="home-recommendations-list" class="space-y-2.5">
                        <!-- Rendered via JS -->
                    </div>
                </div>
            </div>

            <!-- ================= PAGE 2: MENU CATALOGUE VIEW ================= -->
            <div id="view-menu" class="hidden space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <h1 class="text-xl font-bold text-white font-display">Food & Menu</h1>
                        <p class="text-xs text-dineTextMuted">Select dishes to add to draft cart</p>
                    </div>
                    <button onclick="toggleCartDrawer()" class="relative bg-dinePillDark p-2.5 rounded-full text-dineAmber hover:bg-stone-800 transition">
                        <i class="fa-solid fa-basket-shopping text-sm"></i>
                        <span id="cart-badge-count" class="absolute -top-1 -right-1 bg-amber-500 text-stone-950 text-[10px] font-extrabold w-4 h-4 rounded-full flex items-center justify-center">0</span>
                    </button>
                </div>

                <div class="flex items-center space-x-2 overflow-x-auto no-scrollbar py-1 text-xs">
                    <button onclick="filterCategory('All')" class="cat-btn active-cat px-3.5 py-1.5 rounded-full bg-dineAmber text-stone-950 font-semibold whitespace-nowrap transition">All</button>
                    <button onclick="filterCategory('Burgers')" class="cat-btn px-3.5 py-1.5 rounded-full bg-dinePillDark text-stone-300 font-medium whitespace-nowrap hover:bg-stone-800 transition">Burgers</button>
                    <button onclick="filterCategory('Rice meals')" class="cat-btn px-3.5 py-1.5 rounded-full bg-dinePillDark text-stone-300 font-medium whitespace-nowrap hover:bg-stone-800 transition">Rice meals</button>
                    <button onclick="filterCategory('Drinks')" class="cat-btn px-3.5 py-1.5 rounded-full bg-dinePillDark text-stone-300 font-medium whitespace-nowrap hover:bg-stone-800 transition">Drinks</button>
                    <button onclick="filterCategory('Seafood')" class="cat-btn px-3.5 py-1.5 rounded-full bg-dinePillDark text-stone-300 font-medium whitespace-nowrap hover:bg-stone-800 transition">Seafood</button>
                </div>

                <div id="menu-grid" class="space-y-2.5 pb-4">
                    <!-- Rendered via JS -->
                </div>
            </div>

            <!-- ================= PAGE 3: TABLES OVERVIEW VIEW ================= -->
            <div id="view-tables" class="hidden space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <h1 class="text-xl font-bold text-white font-display">Table Status</h1>
                        <p class="text-xs text-dineTextMuted">12 Tables • Real-time floor plan</p>
                    </div>
                    <span class="text-xs bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2.5 py-1 rounded-full font-medium" id="available-count-badge">
                        8 Available
                    </span>
                </div>

                <div class="grid grid-cols-3 gap-2 text-center text-xs">
                    <div class="bg-dinePillDark p-2 rounded-xl border border-white/5">
                        <span class="text-emerald-400 font-bold text-base block" id="stat-avail">8</span>
                        <span class="text-[10px] text-stone-400">Available</span>
                    </div>
                    <div class="bg-dinePillDark p-2 rounded-xl border border-white/5">
                        <span class="text-amber-400 font-bold text-base block" id="stat-occupied">3</span>
                        <span class="text-[10px] text-stone-400">Occupied</span>
                    </div>
                    <div class="bg-dinePillDark p-2 rounded-xl border border-white/5">
                        <span class="text-rose-400 font-bold text-base block" id="stat-reserved">1</span>
                        <span class="text-[10px] text-stone-400">Reserved</span>
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-2.5 pt-1" id="tables-container">
                    <!-- Rendered via JS -->
                </div>
            </div>

            <!-- ================= PAGE 4: KITCHEN & ORDERS VIEW ================= -->
            <div id="view-orders" class="hidden space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <h1 class="text-xl font-bold text-white font-display">Kitchen Workflow</h1>
                        <p class="text-xs text-dineTextMuted">Live Orders Display (KDS)</p>
                    </div>
                    <span class="bg-amber-500/20 text-amber-300 text-xs px-2.5 py-1 rounded-full font-medium border border-amber-500/30 animate-pulse">
                        Live Sync
                    </span>
                </div>

                <div class="flex gap-1.5 bg-dinePillDark p-1 rounded-xl text-xs">
                    <button onclick="filterOrders('all')" class="order-tab-btn active-order-tab flex-1 py-1.5 rounded-lg bg-dineAmber text-stone-950 font-semibold transition">All</button>
                    <button onclick="filterOrders('Preparing')" class="order-tab-btn flex-1 py-1.5 rounded-lg text-stone-300 font-medium hover:text-white transition">Preparing</button>
                    <button onclick="filterOrders('Ready')" class="order-tab-btn flex-1 py-1.5 rounded-lg text-stone-300 font-medium hover:text-white transition">Ready</button>
                    <button onclick="filterOrders('Served')" class="order-tab-btn flex-1 py-1.5 rounded-lg text-stone-300 font-medium hover:text-white transition">Served</button>
                </div>

                <div id="orders-list-container" class="space-y-3 pb-4">
                    <!-- Rendered via JS -->
                </div>
            </div>

            <!-- ================= PAGE 5: STAFF ACCOUNT VIEW ================= -->
            <div id="view-account" class="hidden space-y-4">
                <div class="pt-1">
                    <h1 class="text-xl font-bold text-white font-display">Staff Profile</h1>
                    <p class="text-xs text-dineTextMuted">Manage your shift & system configuration</p>
                </div>

                <div class="bg-dinePillDark p-4 rounded-2xl border border-white/5 flex items-center space-x-3.5">
                    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-dineAmber to-amber-700 flex items-center justify-center text-stone-950 font-bold text-lg shadow-md">
                        JD
                    </div>
                    <div>
                        <h2 class="text-sm font-bold text-white">John Doe</h2>
                        <p class="text-xs text-stone-400">Head Server • Shift #8402</p>
                        <span class="inline-block mt-1 text-[10px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2 py-0.5 rounded-full font-medium">
                            Branch: BGC Taguig Main
                        </span>
                    </div>
                </div>

                <div class="space-y-2 text-xs">
                    <div class="bg-dinePillDark p-3 rounded-xl border border-white/5 flex items-center justify-between">
                        <div class="flex items-center space-x-3 text-stone-200">
                            <i class="fa-solid fa-store text-dineAmber"></i>
                            <span>Current Restaurant Branch</span>
                        </div>
                        <span class="text-stone-400 font-medium">BGC Main Taguig</span>
                    </div>

                    <div class="bg-dinePillDark p-3 rounded-xl border border-white/5 flex items-center justify-between cursor-pointer hover:bg-stone-800 transition" onclick="toggleShiftModal()">
                        <div class="flex items-center space-x-3 text-stone-200">
                            <i class="fa-solid fa-clock text-dineAmber"></i>
                            <span>Shift Management</span>
                        </div>
                        <span class="text-emerald-400 font-semibold" id="account-shift-indicator">Active</span>
                    </div>

                    <div class="bg-dinePillDark p-3 rounded-xl border border-white/5 flex items-center justify-between cursor-pointer hover:bg-stone-800 transition" onclick="showToast('Printer IP: 192.168.1.102 (Connected)')">
                        <div class="flex items-center space-x-3 text-stone-200">
                            <i class="fa-solid fa-print text-dineAmber"></i>
                            <span>Receipt Thermal Printer</span>
                        </div>
                        <span class="text-stone-400">Connected</span>
                    </div>

                    <div class="bg-dinePillDark p-3 rounded-xl border border-white/5 flex items-center justify-between cursor-pointer hover:bg-stone-800 transition" onclick="showToast('Manager PIN Verified Successfully')">
                        <div class="flex items-center space-x-3 text-stone-200">
                            <i class="fa-solid fa-shield-halved text-dineAmber"></i>
                            <span>Manager Override PIN</span>
                        </div>
                        <i class="fa-solid fa-chevron-right text-stone-500 text-[10px]"></i>
                    </div>
                </div>

                <button onclick="showToast('Logged out of DineFlow terminal')" class="w-full bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/20 text-xs font-semibold py-3 rounded-xl transition mt-4">
                    End Shift & Log Out
                </button>
            </div>

        </main>

        <!-- ================= BOTTOM NAVIGATION BAR ================= -->
        <nav class="absolute bottom-0 left-0 right-0 bg-[#1D1616]/95 backdrop-blur-md border-t border-white/5 py-2.5 px-6 flex items-center justify-between z-30">
            <button onclick="switchTab('home')" id="tab-home" class="nav-item flex flex-col items-center space-y-1 text-dineAmber transition">
                <i class="fa-solid fa-house text-lg"></i>
                <span class="text-[10px] font-medium">Home</span>
            </button>

            <button onclick="switchTab('menu')" id="tab-menu" class="nav-item flex flex-col items-center space-y-1 text-stone-400 hover:text-stone-200 transition">
                <i class="fa-solid fa-bars text-lg"></i>
                <span class="text-[10px] font-medium">Menu</span>
            </button>

            <button onclick="switchTab('orders')" id="tab-orders" class="nav-item flex flex-col items-center space-y-1 text-stone-400 hover:text-stone-200 transition relative">
                <i class="fa-solid fa-cart-shopping text-lg"></i>
                <span class="text-[10px] font-medium">Orders</span>
                <span id="nav-order-badge" class="hidden absolute top-0 right-1 w-2 h-2 rounded-full bg-dineAmber"></span>
            </button>

            <button onclick="switchTab('account')" id="tab-account" class="nav-item flex flex-col items-center space-y-1 text-stone-400 hover:text-stone-200 transition">
                <i class="fa-solid fa-circle-user text-lg"></i>
                <span class="text-[10px] font-medium">Account</span>
            </button>
        </nav>

        <div class="absolute bottom-1 left-1/2 -translate-x-1/2 w-32 h-1 bg-stone-500/50 rounded-full z-40 pointer-events-none"></div>

    </div>

    <!-- ================= MODALS & DRAWERS ================= -->

    <!-- CART DRAWER -->
    <div id="cart-drawer" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden transition-opacity duration-300 flex justify-center items-end sm:items-center">
        <div class="w-full max-w-[390px] bg-dineDark border border-white/10 rounded-t-3xl sm:rounded-3xl p-4 space-y-4 max-h-[85vh] flex flex-col shadow-2xl">
            <div class="flex items-center justify-between border-b border-white/10 pb-3">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-basket-shopping text-dineAmber"></i>
                    <h2 class="text-base font-bold text-white font-display">Draft Order Cart</h2>
                </div>
                <button onclick="toggleCartDrawer()" class="text-stone-400 hover:text-white p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <div class="bg-dinePillDark p-2.5 rounded-xl flex items-center justify-between text-xs">
                <span class="text-stone-300">Assign to Table:</span>
                <select id="cart-table-select" class="bg-stone-800 text-dineAmber font-bold rounded px-2 py-1 outline-none border border-white/10">
                    <option value="Table 01">Table 01</option>
                    <option value="Table 02">Table 02</option>
                    <option value="Table 03">Table 03</option>
                    <option value="Table 04">Table 04</option>
                    <option value="Table 05">Table 05</option>
                    <option value="Table 06">Table 06</option>
                    <option value="Table 07">Table 07</option>
                    <option value="Table 08">Table 08</option>
                    <option value="Table 09">Table 09</option>
                    <option value="Table 10">Table 10</option>
                    <option value="Table 11">Table 11</option>
                    <option value="Table 12">Table 12</option>
                </select>
            </div>

            <div id="cart-items-container" class="flex-1 overflow-y-auto space-y-2.5 max-h-[260px] pr-1">
                <!-- Rendered via JS -->
            </div>

            <div class="border-t border-white/10 pt-3 space-y-1.5 text-xs">
                <div class="flex justify-between text-stone-400">
                    <span>Subtotal</span>
                    <span id="cart-subtotal">₱0.00</span>
                </div>
                <div class="flex justify-between text-stone-400">
                    <span>VAT (12%)</span>
                    <span id="cart-vat">₱0.00</span>
                </div>
                <div class="flex justify-between text-sm font-bold text-white pt-1 border-t border-white/5">
                    <span>Total Amount</span>
                    <span class="text-dineAmber" id="cart-total">₱0.00</span>
                </div>
            </div>

            <button onclick="submitOrderToKitchen()" class="w-full bg-dineAmber hover:bg-dineAmberHover text-stone-950 font-bold py-3 rounded-xl transition shadow-lg text-xs uppercase tracking-wider flex items-center justify-center gap-2">
                <i class="fa-solid fa-paper-plane"></i>
                <span>Send Order to Kitchen</span>
            </button>
        </div>
    </div>

    <!-- CUSTOMIZE ITEM MODAL -->
    <div id="custom-modal" class="fixed inset-0 bg-black/75 backdrop-blur-sm z-50 hidden flex justify-center items-center p-4">
        <div class="w-full max-w-[350px] bg-dineDark border border-white/10 rounded-2xl p-4 space-y-4 shadow-2xl">
            <div class="flex items-start justify-between">
                <div>
                    <h3 id="modal-item-name" class="text-base font-bold text-white">Item Name</h3>
                    <p id="modal-item-price" class="text-xs text-dineAmber font-semibold">₱0.00</p>
                </div>
                <button onclick="closeCustomModal()" class="text-stone-400 hover:text-white">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="space-y-2 text-xs">
                <label class="block text-stone-300 font-medium">Special Instructions / Notes:</label>
                <textarea id="modal-item-notes" rows="2" placeholder="e.g. Extra sauce, no onions, medium rare"
                    class="w-full bg-dinePillDark text-white p-2.5 rounded-xl outline-none border border-white/10 focus:border-dineAmber resize-none"></textarea>
            </div>

            <div class="flex items-center justify-between text-xs pt-2">
                <span class="text-stone-300 font-medium">Quantity:</span>
                <div class="flex items-center space-x-3 bg-dinePillDark rounded-xl p-1 border border-white/5">
                    <button onclick="adjustModalQty(-1)" class="w-7 h-7 rounded-lg bg-stone-800 text-white font-bold flex items-center justify-center hover:bg-stone-700">-</button>
                    <span id="modal-qty-text" class="font-bold text-white w-4 text-center">1</span>
                    <button onclick="adjustModalQty(1)" class="w-7 h-7 rounded-lg bg-stone-800 text-white font-bold flex items-center justify-center hover:bg-stone-700">+</button>
                </div>
            </div>

            <button onclick="confirmAddToCart()" class="w-full bg-dineAmber hover:bg-dineAmberHover text-stone-950 font-bold py-2.5 rounded-xl transition text-xs">
                Add to Cart
            </button>
        </div>
    </div>

    <!-- SHIFT MANAGEMENT MODAL -->
    <div id="shift-modal" class="fixed inset-0 bg-black/75 backdrop-blur-sm z-50 hidden flex justify-center items-center p-4">
        <div class="w-full max-w-[340px] bg-dineDark border border-white/10 rounded-2xl p-4 space-y-3 shadow-2xl text-xs">
            <h3 class="text-base font-bold text-white flex items-center gap-2">
                <i class="fa-solid fa-user-clock text-dineAmber"></i>
                Shift Status Control
            </h3>
            <p class="text-stone-300">Toggle active working state to pause or resume order taking permissions.</p>

            <div class="bg-dinePillDark p-3 rounded-xl border border-white/5 space-y-1">
                <div class="flex justify-between">
                    <span class="text-stone-400">Shift Started:</span>
                    <span class="text-white font-medium">8:00 AM Today</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-stone-400">Active Duration:</span>
                    <span class="text-white font-medium">5h 15m</span>
                </div>
            </div>

            <div class="flex gap-2 pt-2">
                <button onclick="toggleShiftState(true)" class="flex-1 bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2 rounded-xl transition">
                    Active
                </button>
                <button onclick="toggleShiftState(false)" class="flex-1 bg-amber-600 hover:bg-amber-500 text-white font-bold py-2 rounded-xl transition">
                    On Break
                </button>
            </div>
            <button onclick="toggleShiftModal()" class="w-full bg-stone-800 text-stone-300 py-2 rounded-xl hover:bg-stone-700">Close</button>
        </div>
    </div>

    <!-- ================= JAVASCRIPT LOGIC ================= -->
    <script>
        // Menu Dataset
        const menuItems = [
            { id: 1, name: 'Classic Cheeseburger', category: 'Burgers', time: '15–20 min', price: 320, image: 'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=300&q=80', recommended: true },
            { id: 2, name: 'Chicken Rice Bowl', category: 'Rice meals', time: '10–15 min', price: 180, image: 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=300&q=80', recommended: true },
            { id: 3, name: 'Iced Coffee Latte', category: 'Drinks', time: '5–10 min', price: 240, image: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=300&q=80', recommended: true },
            { id: 4, name: 'Grilled Salmon Seafood', category: 'Seafood', time: '20–25 min', price: 520, image: 'https://images.unsplash.com/photo-1467003909585-2f8a72700288?auto=format&fit=crop&w=300&q=80', recommended: false },
            { id: 5, name: 'Crispy Wings Meal', category: 'Rice meals', time: '12–18 min', price: 260, image: 'https://images.unsplash.com/photo-1562967914-608f82629710?auto=format&fit=crop&w=300&q=80', recommended: false }
        ];

        let tables = [
            { id: 1, name: 'Table 01', seats: 2, status: 'Occupied', orderId: '#101', time: '25m' },
            { id: 2, name: 'Table 02', seats: 4, status: 'Available', orderId: null, time: '' },
            { id: 3, name: 'Table 03', seats: 4, status: 'Available', orderId: null, time: '' },
            { id: 4, name: 'Table 04', seats: 2, status: 'Occupied', orderId: '#102', time: '12m' },
            { id: 5, name: 'Table 05', seats: 6, status: 'Reserved', orderId: null, time: '7:00 PM' },
            { id: 6, name: 'Table 06', seats: 4, status: 'Available', orderId: null, time: '' },
            { id: 7, name: 'Table 07', seats: 2, status: 'Available', orderId: null, time: '' },
            { id: 8, name: 'Table 08', seats: 4, status: 'Cleaning', orderId: null, time: '' },
            { id: 9, name: 'Table 09', seats: 8, status: 'Available', orderId: null, time: '' },
            { id: 10, name: 'Table 10', seats: 2, status: 'Available', orderId: null, time: '' },
            { id: 11, name: 'Table 11', seats: 4, status: 'Occupied', orderId: '#103', time: '40m' },
            { id: 12, name: 'Table 12', seats: 4, status: 'Available', orderId: null, time: '' }
        ];

        let orders = [
            { id: '#101', table: 'Table 01', status: 'Preparing', time: '10 min ago', items: [{ name: 'Classic Cheeseburger', qty: 2, price: 320 }] },
            { id: '#102', table: 'Table 04', status: 'Ready', time: '5 min ago', items: [{ name: 'Chicken Rice Bowl', qty: 1, price: 180 }] }
        ];

        let cart = [];
        let currentSelectedCategory = 'All';
        let currentMenuSearch = '';
        let currentModalItem = null;
        let currentModalQty = 1;
        let currentOrderFilter = 'all';

        // Start the interface and render its initial content.
        window.addEventListener('DOMContentLoaded', function () {
            updateClock();
            setInterval(updateClock, 30000);
            renderRecommendations();
            renderMenu();
            renderTables();
            renderOrders();
            updateCartBadge();
        });

        function updateClock() {
            const now = new Date();
            let hours = now.getHours();
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const periodHours = hours % 12 || 12;
            document.getElementById('current-time').innerText = `${periodHours}:${minutes}`;
        }

        // Switch between the app's existing views without changing its design.
        function switchTab(tabName) {
            const tabs = ['home', 'menu', 'tables', 'orders', 'account'];

            tabs.forEach(tab => {
                const view = document.getElementById(`view-${tab}`);
                if (view) view.classList.add('hidden');

                const navButton = document.getElementById(`tab-${tab}`);
                if (navButton) {
                    navButton.classList.remove('text-dineAmber');
                    navButton.classList.add('text-stone-400');
                }
            });

            const selectedView = document.getElementById(`view-${tabName}`);
            if (selectedView) selectedView.classList.remove('hidden');

            const selectedNav = document.getElementById(`tab-${tabName}`);
            if (selectedNav) {
                selectedNav.classList.remove('text-stone-400');
                selectedNav.classList.add('text-dineAmber');
            }

            // Keep rendered lists current whenever their screen is opened.
            if (tabName === 'menu') renderMenu();
            if (tabName === 'tables') renderTables();
            if (tabName === 'orders') renderOrders();
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').innerText = message;
            toast.classList.remove('-translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.add('-translate-y-20', 'opacity-0');
                toast.classList.remove('translate-y-0', 'opacity-100');
            }, 2500);
        }

        function renderRecommendations() {
            const container = document.getElementById('home-recommendations-list');
            const recommendations = menuItems.filter(item => item.recommended);

            container.innerHTML = recommendations.map(item => `
                <div class="bg-dinePillDark p-2.5 rounded-xl border border-white/5 flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <img src="${item.image}" alt="${item.name}" class="w-12 h-12 rounded-lg object-cover">
                        <div>
                            <h4 class="text-xs font-bold text-white">${item.name}</h4>
                            <p class="text-[10px] text-dineTextMuted">${item.category} • ${item.time}</p>
                            <span class="text-xs font-bold text-dineAmber">₱${item.price.toFixed(2)}</span>
                        </div>
                    </div>
                    <button onclick="openCustomModal(${item.id})" class="bg-dineAmber hover:bg-dineAmberHover text-stone-950 p-2 rounded-lg text-xs font-bold transition">
                        <i class="fa-solid fa-plus"></i>
                    </button>
                </div>
            `).join('');
        }

        // Menu categories and search.
        function filterCategory(category) {
            currentSelectedCategory = category;
            currentMenuSearch = '';

            document.querySelectorAll('.cat-btn').forEach(button => {
                const isActive = button.innerText.trim().toLowerCase() === category.toLowerCase();
                button.className = isActive
                    ? 'cat-btn px-3.5 py-1.5 rounded-full bg-dineAmber text-stone-950 font-semibold whitespace-nowrap transition'
                    : 'cat-btn px-3.5 py-1.5 rounded-full bg-dinePillDark text-stone-300 font-medium whitespace-nowrap hover:bg-stone-800 transition';
            });

            const homeSearch = document.querySelector('#view-home input');
            if (homeSearch) homeSearch.value = '';
            renderMenu();
        }

        function renderMenu(search = currentMenuSearch) {
            const container = document.getElementById('menu-grid');
            currentMenuSearch = search;

            let filteredItems = menuItems;

            if (currentSelectedCategory !== 'All') {
                filteredItems = filteredItems.filter(item =>
                    item.category.toLowerCase() === currentSelectedCategory.toLowerCase()
                );
            }

            if (search.trim()) {
                filteredItems = filteredItems.filter(item =>
                    item.name.toLowerCase().includes(search.trim().toLowerCase()) ||
                    item.category.toLowerCase().includes(search.trim().toLowerCase())
                );
            }

            if (filteredItems.length === 0) {
                container.innerHTML = `<div class="text-center py-8 text-stone-400 text-xs">No food items found matching your filter.</div>`;
                return;
            }

            container.innerHTML = filteredItems.map(item => `
                <div class="bg-dinePillDark p-3 rounded-2xl border border-white/5 flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <img src="${item.image}" alt="${item.name}" class="w-14 h-14 rounded-xl object-cover">
                        <div>
                            <h4 class="text-xs font-bold text-white">${item.name}</h4>
                            <p class="text-[10px] text-dineTextMuted">${item.category} • ${item.time}</p>
                            <p class="text-xs font-bold text-dineAmber mt-0.5">₱${item.price.toFixed(2)}</p>
                        </div>
                    </div>
                    <button onclick="openCustomModal(${item.id})" class="bg-dineAmber hover:bg-dineAmberHover text-stone-950 px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1">
                        <i class="fa-solid fa-plus text-[10px]"></i> Add
                    </button>
                </div>
            `).join('');
        }

        function handleHomeSearch(value) {
            currentMenuSearch = value;
            if (value.trim().length > 0) {
                switchTab('menu');
                renderMenu(value);
            } else {
                renderMenu('');
            }
        }

        // Item customization modal.
        function openCustomModal(id) {
            currentModalItem = menuItems.find(item => item.id === id);
            if (!currentModalItem) return;

            currentModalQty = 1;
            document.getElementById('modal-item-name').innerText = currentModalItem.name;
            document.getElementById('modal-item-price').innerText = `₱${currentModalItem.price.toFixed(2)}`;
            document.getElementById('modal-qty-text').innerText = currentModalQty;
            document.getElementById('modal-item-notes').value = '';
            document.getElementById('custom-modal').classList.remove('hidden');
        }

        function closeCustomModal() {
            document.getElementById('custom-modal').classList.add('hidden');
        }

        function adjustModalQty(change) {
            currentModalQty = Math.max(1, currentModalQty + change);
            document.getElementById('modal-qty-text').innerText = currentModalQty;
        }

        function confirmAddToCart() {
            if (!currentModalItem) return;

            const notes = document.getElementById('modal-item-notes').value.trim();
            cart.push({ ...currentModalItem, qty: currentModalQty, notes });

            closeCustomModal();
            updateCartBadge();
            showToast(`Added ${currentModalItem.name} to cart`);
        }

        // Cart drawer and totals.
        function toggleCartDrawer() {
            const drawer = document.getElementById('cart-drawer');
            drawer.classList.toggle('hidden');
            renderCart();
        }

        function updateCartBadge() {
            const totalItems = cart.reduce((total, item) => total + item.qty, 0);
            document.getElementById('cart-badge-count').innerText = totalItems;

            const navBadge = document.getElementById('nav-order-badge');
            navBadge.classList.toggle('hidden', totalItems === 0);
        }

        function renderCart() {
            const container = document.getElementById('cart-items-container');

            if (cart.length === 0) {
                container.innerHTML = `<div class="text-center py-8 text-stone-400 text-xs">Your draft cart is empty. Add items from the menu.</div>`;
                document.getElementById('cart-subtotal').innerText = '₱0.00';
                document.getElementById('cart-vat').innerText = '₱0.00';
                document.getElementById('cart-total').innerText = '₱0.00';
                updateCartBadge();
                return;
            }

            container.innerHTML = cart.map((item, index) => `
                <div class="bg-dinePillDark p-2.5 rounded-xl border border-white/5 flex items-center justify-between text-xs">
                    <div>
                        <h4 class="font-bold text-white">${item.name}</h4>
                        <p class="text-[10px] text-stone-400">Qty: ${item.qty}${item.notes ? ' • ' + item.notes : ''}</p>
                        <span class="text-dineAmber font-semibold">₱${(item.price * item.qty).toFixed(2)}</span>
                    </div>
                    <button onclick="removeFromCart(${index})" class="text-rose-400 hover:text-rose-300 p-1">
                        <i class="fa-solid fa-trash text-xs"></i>
                    </button>
                </div>
            `).join('');

            const subtotal = cart.reduce((total, item) => total + item.price * item.qty, 0);
            const vat = subtotal * 0.12;
            const total = subtotal + vat;

            document.getElementById('cart-subtotal').innerText = `₱${subtotal.toFixed(2)}`;
            document.getElementById('cart-vat').innerText = `₱${vat.toFixed(2)}`;
            document.getElementById('cart-total').innerText = `₱${total.toFixed(2)}`;
            updateCartBadge();
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            renderCart();
        }

        function submitOrderToKitchen() {
            if (cart.length === 0) {
                showToast('Cart is empty!');
                return;
            }

            const table = document.getElementById('cart-table-select').value;
            const newOrderId = '#' + Math.floor(100 + Math.random() * 900);

            orders.unshift({
                id: newOrderId,
                table,
                status: 'Preparing',
                time: 'Just now',
                items: cart.map(item => ({ ...item }))
            });

            const tableObject = tables.find(item => item.name.toLowerCase() === table.toLowerCase());
            if (tableObject) {
                tableObject.status = 'Occupied';
                tableObject.orderId = newOrderId;
                tableObject.time = 'Just now';
            }

            cart = [];
            toggleCartDrawer();
            updateCartBadge();
            renderTables();
            renderOrders();
            switchTab('orders');
            showToast(`Order ${newOrderId} sent to Kitchen successfully!`);
        }

        // Table status screen.
        function renderTables() {
            const container = document.getElementById('tables-container');
            const availableCount = tables.filter(table => table.status === 'Available').length;
            const occupiedCount = tables.filter(table => table.status === 'Occupied').length;
            const reservedCount = tables.filter(table => table.status === 'Reserved').length;

            document.getElementById('stat-avail').innerText = availableCount;
            document.getElementById('stat-occupied').innerText = occupiedCount;
            document.getElementById('stat-reserved').innerText = reservedCount;
            document.getElementById('available-count-badge').innerText = `${availableCount} Available`;

            container.innerHTML = tables.map(table => {
                let statusColor = 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20';
                if (table.status === 'Occupied') statusColor = 'bg-amber-500/10 text-amber-400 border-amber-500/20';
                if (table.status === 'Reserved') statusColor = 'bg-rose-500/10 text-rose-400 border-rose-500/20';
                if (table.status === 'Cleaning') statusColor = 'bg-indigo-500/10 text-indigo-400 border-indigo-500/20';

                return `
                    <div class="bg-dinePillDark p-3 rounded-2xl border border-white/5 flex flex-col justify-between space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-white">${table.name}</span>
                            <span class="text-[9px] px-2 py-0.5 rounded-full border ${statusColor} font-semibold">${table.status}</span>
                        </div>
                        <div class="text-[10px] text-stone-400">
                            Seats: ${table.seats} ${table.orderId ? '<br>Order: ' + table.orderId : ''}
                        </div>
                        <button onclick="toggleTableStatus(${table.id})" class="w-full bg-stone-800 hover:bg-stone-700 text-stone-300 text-[10px] py-1 rounded-lg transition">
                            Change Status
                        </button>
                    </div>
                `;
            }).join('');
        }

        function toggleTableStatus(id) {
            const table = tables.find(item => item.id === id);
            if (!table) return;

            const statuses = ['Available', 'Occupied', 'Reserved', 'Cleaning'];
            table.status = statuses[(statuses.indexOf(table.status) + 1) % statuses.length];

            if (table.status === 'Available') {
                table.orderId = null;
                table.time = '';
            }

            renderTables();
            showToast(`${table.name} status updated to ${table.status}`);
        }

        // Kitchen orders and status filters.
        function filterOrders(status) {
            currentOrderFilter = status;

            document.querySelectorAll('.order-tab-btn').forEach(button => {
                const isActive = button.innerText.trim().toLowerCase() === status.toLowerCase();
                button.className = isActive
                    ? 'order-tab-btn flex-1 py-1.5 rounded-lg bg-dineAmber text-stone-950 font-semibold transition'
                    : 'order-tab-btn flex-1 py-1.5 rounded-lg text-stone-300 font-medium hover:text-white transition';
            });

            renderOrders();
        }

        function renderOrders() {
            const container = document.getElementById('orders-list-container');
            let filteredOrders = orders;

            if (currentOrderFilter !== 'all') {
                filteredOrders = orders.filter(order =>
                    order.status.toLowerCase() === currentOrderFilter.toLowerCase()
                );
            }

            if (filteredOrders.length === 0) {
                container.innerHTML = `<div class="text-center py-8 text-stone-400 text-xs">No active orders in this queue.</div>`;
                return;
            }

            container.innerHTML = filteredOrders.map(order => {
                let badgeClass = 'bg-amber-500/20 text-amber-300 border-amber-500/30';
                if (order.status === 'Ready') badgeClass = 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30';
                if (order.status === 'Served') badgeClass = 'bg-stone-700 text-stone-300 border-stone-600';

                const orderItems = order.items.map(item => `
                    <div class="flex justify-between">
                        <span>${item.qty}× ${item.name}</span>
                        <span class="text-stone-400">₱${(item.price * item.qty).toFixed(2)}</span>
                    </div>
                `).join('');

                let actionButton = '';
                if (order.status === 'Preparing') {
                    actionButton = `<button onclick="updateOrderStatus('${order.id}', 'Ready')" class="bg-amber-500 hover:bg-amber-400 text-stone-950 font-bold px-3 py-1 rounded-lg transition">Mark Ready</button>`;
                } else if (order.status === 'Ready') {
                    actionButton = `<button onclick="updateOrderStatus('${order.id}', 'Served')" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-3 py-1 rounded-lg transition">Mark as Served</button>`;
                }

                return `
                    <div class="bg-dinePillDark p-3.5 rounded-2xl border border-white/5 space-y-2.5 text-xs">
                        <div class="flex items-center justify-between border-b border-white/5 pb-2">
                            <div>
                                <span class="font-bold text-white">${order.id}</span>
                                <span class="text-stone-400 text-[11px] ml-1.5">• ${order.table}</span>
                            </div>
                            <span class="px-2.5 py-0.5 rounded-full border text-[10px] font-semibold ${badgeClass}">${order.status}</span>
                        </div>
                        <div class="space-y-1 text-stone-300">${orderItems}</div>
                        <div class="flex items-center justify-between pt-2 border-t border-white/5 text-[11px]">
                            <span class="text-stone-400">${order.time}</span>
                            <div class="flex gap-2">${actionButton}</div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function updateOrderStatus(id, newStatus) {
            const order = orders.find(item => item.id === id);
            if (!order) return;

            order.status = newStatus;
            renderOrders();
            showToast(`Order ${id} updated to ${newStatus}`);
        }

        // Shift controls.
        function toggleShiftModal() {
            document.getElementById('shift-modal').classList.toggle('hidden');
        }

        function toggleShiftState(isActive) {
            const statusText = document.getElementById('shift-status-text');
            const accountIndicator = document.getElementById('account-shift-indicator');

            if (isActive) {
                statusText.innerText = 'Active';
                statusText.className = 'text-emerald-400';
                accountIndicator.innerText = 'Active';
                accountIndicator.className = 'text-emerald-400 font-semibold';
                showToast('Shift resumed successfully.');
            } else {
                statusText.innerText = 'On Break';
                statusText.className = 'text-amber-400';
                accountIndicator.innerText = 'On Break';
                accountIndicator.className = 'text-amber-400 font-semibold';
                showToast('Shift paused for break.');
            }

            toggleShiftModal();
        }
    </script>
</body>
</html>
